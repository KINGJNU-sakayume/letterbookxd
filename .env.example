# 배포 빌드용: 알라딘 프록시(Cloudflare Worker) 주소.
# GitHub 저장소 변수(Settings → Secrets and variables → Actions → Variables)로 넣는다.
# VITE_ALADIN_PROXY_URL=https://letterbookxd-aladin.<subdomain>.workers.dev

# 로컬 개발 전용: npm run dev의 /aladin-api 프록시가 붙이는 알라딘 TTB 키.
# VITE_ 접두사가 없어서 번들에 들어가지 않는다. .env에만 두고 커밋하지 않는다.
# ALADIN_TTB_KEY=ttbxxxxxxxxxxxx
